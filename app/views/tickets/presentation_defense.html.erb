    <div class="code-snippet">
# app/models/ticket.rb (Satır 88-92):
def calculate_due_date(base_time, duration)
  # Hafta sonunu saymama kuralı tam olarak bu metoda yazılır:
  target = base_time + duration
  # Örnek: while target.saturday? || target.sunday? do target += 1.day end
  target
end
