    <!-- Code Block 1: Durum Geçişi -->
    <div style="margin-bottom: 16px;">
      <strong style="font-size: 13px; color: #a5b4fc;">A) Durum Geçiş Kuralı (State Machine): <code>app/models/ticket.rb</code></strong>
      <div class="code-snippet">
VALID_TRANSITIONS = {
  "new_ticket" => %w[open solved closed],
  "open"       => %w[pending solved closed],
  "pending"    => %w[open solved closed],
  "solved"     => %w[open closed],
  "closed"     => %w[] # Kapatılan bilet kilitlenir, doğrudan açılamaz!
}.freeze

def transition_to!(new_status, actor_name: "System", reason: nil)
  raise StandardError, "Geçersiz durum geçişi!" unless can_transition_to?(new_status)
  # updates status, timestamps (resolved_at, closed_at), and creates audit event
end
      </div>
    </div>

    <!-- Code Block 2: Zaman Kuralı (travel_to testli) -->
    <div>
      <strong style="font-size: 13px; color: #a5b4fc;">B) Zaman Kuralı & 48 Saatlik Otomatik Kapatma: <code>app/models/ticket.rb</code> & <code>test/models/ticket_test.rb</code></strong>
      <div class="code-snippet">
# TIME RULE 1: 48 Saat Boyunca Çözülmüş Kalan Biletlerin Otomatik Kapatılması
def self.auto_close_solved_tickets!(threshold = 48.hours.ago)
  where(status: "solved").where("resolved_at <= ?", threshold).find_each do |ticket|
    ticket.transition_to!("closed", reason: "48 saatlik hareketsizlik sonrası otomatik kapatıldı.")
  end
end

# TEST (test/models/ticket_test.rb):
test "travel_to ile çözülen bilet 48 saat sonra otomatik closed olur" do
  travel_to @base_time do
    ticket.transition_to!("solved")
    travel 49.hours
    Ticket.auto_close_solved_tickets!
    assert_equal "closed", ticket.reload.status
  end
end
